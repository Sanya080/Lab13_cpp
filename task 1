#include <iostream>

using namespace std;

long long reverseDigits(const long long *k)
{
    long long n = *k;
    long long result = 0;
    while (n > 0)
    {
        result = result * 10 + n % 10;
        n /= 10;
    }
    return result;
}

int main()
{
    const int COUNT = 5;
    long long numbers[COUNT];

    cout << "Введіть " << COUNT << " цілих додатних чисел:" << endl;
    for (int i = 0; i < COUNT; i++)
    {
        do
        {
            cout << "K" << i + 1 << " = ";
            cin >> numbers[i];
            if (numbers[i] <= 0)
                cout << "Число має бути додатним, повторіть введення" << endl;
        } while (numbers[i] <= 0);
    }

    cout << "Числа із зворотним порядком цифр:" << endl;
    for (int i = 0; i < COUNT; i++)
        cout << numbers[i] << " -> " << reverseDigits(&numbers[i]) << endl;

    return 0;
}
